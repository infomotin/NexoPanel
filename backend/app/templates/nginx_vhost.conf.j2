# Managed by NexoPanel NginxProvider
server {
    listen 80;
    listen [::]:80;
    server_name {{ server_names }};

    root {{ document_root }};
    index index.php index.html index.htm;

    access_log /var/log/nginx/{{ domain }}.access.log combined;
    error_log /var/log/nginx/{{ domain }}.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        alias /var/www/acme-challenge/.well-known/acme-challenge/;
        default_type "text/plain";
        try_files $uri =404;
    }

    {% if ssl_enabled and force_https %}
    location / {
        return 301 https://$host$request_uri;
    }
    {% else %}
    {% if runtime_type == 'proxy' and proxy_upstream %}
    location / {
        proxy_pass {{ proxy_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    {% elif runtime_type == 'php' %}
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
    }
    {% else %}
    location / {
        try_files $uri $uri/ /index.html =404;
    }
    {% endif %}
    {% endif %}

    {% if custom_directives %}
    # Custom Directives
    {{ custom_directives }}
    {% endif %}
}

{% if ssl_enabled and ssl_cert_path and ssl_key_path %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ server_names }};

    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    root {{ document_root }};
    index index.php index.html index.htm;

    access_log /var/log/nginx/{{ domain }}.access.log combined;
    error_log /var/log/nginx/{{ domain }}.error.log warn;

    {% if runtime_type == 'proxy' and proxy_upstream %}
    location / {
        proxy_pass {{ proxy_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    {% elif runtime_type == 'php' %}
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
    }
    {% else %}
    location / {
        try_files $uri $uri/ /index.html =404;
    }
    {% endif %}

    {% if custom_directives %}
    # Custom Directives
    {{ custom_directives }}
    {% endif %}
}
{% endif %}
